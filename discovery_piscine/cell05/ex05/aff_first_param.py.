#!/usr/bin/env python3
import sys

                                # 1. เช็กความยาวของ sys.argv เพื่อดูว่ามีการส่งพารามิเตอร์เข้ามาหรือไม่
                                # เนื่องจาก sys.argv[0] คือชื่อไฟล์เสมอ ถ้าความยาวมีแค่ 1 แสดงว่าไม่มีพารามิเตอร์อื่นส่งมาเลย
if len(sys.argv) < 2:
    print("none")
else: 
    print(sys.argv[1])          # 2. ถ้ามีพารามิเตอร์ส่งมา ให้ดึงตัวแรกสุดที่ส่งมาจริง ๆ ซึ่งอยู่ที่ดัชนีตัวที่ 1 (sys.argv[1])






'''
========================== การสร้าง  ==========================


1. การใช้ตรรกะตรวจหาพารามิเตอร์ (len(sys.argv) < 2)

• Syntax: len(sys.argv) < 2
• คำอธิบาย: เครื่องหมาย < คือ "น้อยกว่า" (Less than)
• หลักการคิด: จากที่เราเรียนรู้ไปในโจทย์ก่อนหน้าว่า sys.argv จะเก็บชื่อไฟล์ไว้ในตำแหน่งแรกสุดเสมอดังนี้:
	• หากเปิดโปรแกรมเฉย ๆ sys.argv จะมีค่าเป็น ['aff_first_param.py'] ซึ่งมีความยาว len เท่ากับ 1
	• หากเปิดโปรแกรมพร้อมพารามิเตอร์ 1 ตัว sys.argv จะมีค่าเป็น ['aff_first_param.py', 'Code Ninja'] ซึ่งมีความยาว len เท่ากับ 2
• ดังนั้น การตั้งเงื่อนไขว่า "ถ้าน้อยกว่า 2" จึงเป็นวิธีเช็กที่แม่นยำที่สุดว่าผู้ใช้ไม่ได้พิมพ์พารามิเตอร์ใด ๆ ตามหลังชื่อไฟล์มาเลย


2. การดึงพารามิเตอร์ตัวแรกสุด (sys.argv[1])

• ในภาษาคอมพิวเตอร์ การนับตำแหน่ง (Index) ในลิสต์จะเริ่มต้นที่เลข 0 เสมอ
• sys.argv[0] \(\rightarrow \) เก็บชื่อไฟล์โปรแกรม
• sys.argv[1] \(\rightarrow \) เก็บพารามิเตอร์ตัวแรกที่ผู้ใช้พิมพ์เข้ามาจริง ๆ (เช่น "Code Ninja") เราจึงเจาะจงดึงเฉพาะค่าในตำแหน่งนี้มาแสดงผลออกทางหน้าจอนั่นเองครับ






==============================================================================
'''


